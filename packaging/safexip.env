# Required. Generate with: openssl rand -hex 32
# The service refuses to start until this contains at least 32 characters.
SAFEXIP_API_KEY=

# DNS zone served by safexip.
SAFEXIP_DOMAIN=xip.example.com
SAFEXIP_NS_HOSTNAME=ns1.xip.example.com
SAFEXIP_NS_HOSTNAME2=ns2.xip.example.com
SAFEXIP_NS_IP=127.0.0.1

# Bind addresses and ports.
SAFEXIP_DNS_BIND=0.0.0.0
SAFEXIP_DNS_PORT=53
# Keep the credential-bearing API private. Put an HTTPS reverse proxy in front
# when remote ACME clients need access.
SAFEXIP_API_BIND=127.0.0.1
SAFEXIP_API_PORT=8080

# Challenge tokens expire even when an ACME client fails to clean them up.
SAFEXIP_TOKEN_LIFETIME=600
SAFEXIP_MAX_TOKENS=100

# RUST_LOG=safexip=debug
