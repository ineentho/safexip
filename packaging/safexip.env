# Required.
SAFEXIP_API_KEY=

# DNS zone served by safexip.
SAFEXIP_DOMAIN=xip.example.com
SAFEXIP_NS_HOSTNAME=ns1.xip.example.com
SAFEXIP_NS_HOSTNAME2=ns2.xip.example.com
SAFEXIP_NS_IP=127.0.0.1

# Bind addresses and ports.
SAFEXIP_DNS_BIND=0.0.0.0
SAFEXIP_DNS_PORT=53
SAFEXIP_API_BIND=0.0.0.0
SAFEXIP_API_PORT=8080

# RUST_LOG=safexip=debug
